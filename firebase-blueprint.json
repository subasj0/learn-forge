{
  "entities": {
    "User": {
      "title": "User",
      "description": "A user of the application",
      "type": "object",
      "properties": {
        "email": {
          "type": "string"
        },
        "displayName": {
          "type": "string"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["email", "createdAt"]
    },
    "Course": {
      "title": "Course",
      "description": "An interactive book/course generated by the user",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "ID of the user who owns this course"
        },
        "authorName": {
          "type": "string",
          "description": "Name of the author"
        },
        "title": {
          "type": "string"
        },
        "topic": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": ["draft_outline", "generating_chapters", "ready", "failed"]
        },
        "outline": {
          "type": "object",
          "description": "The table of contents (Parts and Chapters)"
        },
        "isPublic": {
          "type": "boolean",
          "description": "Whether this course is public or not"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["userId", "title", "topic", "status", "createdAt", "updatedAt"]
    },
    "Chapter": {
      "title": "Chapter",
      "description": "A single chapter of the course",
      "type": "object",
      "properties": {
        "courseId": {
          "type": "string"
        },
        "chapterId": {
          "type": "string"
        },
        "mainContent": {
          "type": "array",
          "description": "Blocks for the center column"
        },
        "sidebarContent": {
          "type": "array",
          "description": "Blocks for the right sidebar (quizzes, try it yourself)"
        },
        "order": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["courseId", "chapterId", "mainContent", "sidebarContent", "order", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profiles"
    },
    "/courses/{courseId}": {
      "schema": { "$ref": "#/entities/Course" },
      "description": "Generated courses/books"
    },
    "/courses/{courseId}/chapters/{chapterId}": {
      "schema": { "$ref": "#/entities/Chapter" },
      "description": "Chapters inside a course"
    }
  }
}
